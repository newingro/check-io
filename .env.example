# ─────────────────────────────────────────────────────────────
# CHECK-iO — variabili d'ambiente
# Copia in .env.local per lo sviluppo e configura le stesse
# variabili su Vercel (Project → Settings → Environment Variables).
# Nessuna di queste variabili deve essere esposta al client.
# ─────────────────────────────────────────────────────────────

# Ricezione delle richieste dai moduli: configura ALMENO un canale.
# Senza canali attivi il sito NON simula l'invio e mostra all'utente
# i contatti alternativi (telefono e WhatsApp).

# 1) Email tramite Resend (https://resend.com) — dominio mittente verificato
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL="CHECK-iO <richieste@check-io.it>"

# 2) Webhook (CRM, Make, Zapier, n8n…) — riceve un JSON firmato HMAC-SHA256
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
